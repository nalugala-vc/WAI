# Local dev: used by the browser client directly.
# Vercel production: set the same value as WAI_API_KEY (server proxy).
VITE_WAI_API_KEY=wai_your_key_here
WAI_API_KEY=wai_your_key_here

# Optional — only for production if sidebar place search hits CORS errors.
# Dev uses the Vite /nominatim proxy automatically (see README).
# VITE_NOMINATIM_BASE_URL=https://your-server.example/nominatim
